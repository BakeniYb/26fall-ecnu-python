























n = 440312
f = 3.1415926

s1 = f"{n}"
s2 = f"{f}"

s1





int(s1)


# 字符串里包含的如果是整数，则不仅可以转为整数，也可以转为等值的浮点数
float(s1)


# 字符串里包含的如果是浮点数，则可以转为浮点数，但不能直接转为整数
float(s2)
# int(s2) 不可以，会报错





int(float(s2))


s3 = "440abc312"
s4 = "3.l4l5g26"








def is_float(s):
    try:
        float(s)
        return True
    except ValueError:
        return False

def is_int(s):
    try:
        int(s)
        return True
    except ValueError:
        return False

def parse_str(s):
    if is_int(s):
        print(f"输入是整数，为{int(s)}")
    elif is_float(s):
        print(f"输入是浮点数，为{float(s)}")
    else:
        print(f"输入“{s}”不是数值类型")





parse_str('345')


parse_str('3.42')


parse_str('haha')


parse_str(s1)
parse_str(s2)
parse_str(s3)
parse_str(s4)








