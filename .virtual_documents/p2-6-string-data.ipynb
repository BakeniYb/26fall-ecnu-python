fast_float('56.07') # => 56.07


fast_float(54) # => 54.0


fast_float('bad input') # => 'bad input'


fast_float('bad input', default=0) # => 0


fast_float('bad input', 0) # => 0


fast_float('Ⅴ') # '\u2164' 罗马数字 5

















