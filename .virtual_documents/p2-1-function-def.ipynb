def idiv(a, b):
    quotient = a // b
    remainder = a % b
    return quotient, remainder

q, r = idiv(50, 6)
print(q, r)











def add(x, y):
    return x + y

result = add(3, 5)
print(result) # 输出: 8








def increase_one(n):
    n += 1
    return n

n = 1
print(increase_one(n))
print(n)

















def greeting(name, msg='Hi', punc='!'):
    print(f'{msg}, {name}{punc}')


greeting('Neo')


greeting('Neo', 'Good morning') # 指定值会覆盖默认值


greeting('Neo',punc='.')


greeting('Neo', msg='Good Morning', punc='.')














